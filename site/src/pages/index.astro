---
import Base from "../layouts/Base.astro";
import HeroAquarium from "../components/HeroAquarium.astro";

const pillars = [
  {
    symbol: "",
    index: "01 — MEMORY",
    title: "Context stays.",
    text: "Decisions become a lasting, readable trail instead of a fleeting chat log.",
  },
  {
    symbol: "",
    index: "02 — TRACE",
    title: "Consequences become visible.",
    text: "Amanos links each decision to its possible impact — as a candidate, never a claim.",
  },
  {
    symbol: "",
    index: "03 — CONTROL",
    title: "Humans decide.",
    text: "No silent push, no automatic merge, no invisible change to an active branch.",
  },
];

const statuses = [
  ["○", "draft", "not yet certain"],
  ["●", "active", "valid decision"],
  ["!", "blocked", "next step needed"],
  ["✓", "done", "implemented locally"],
  ["◇", "candidate", "possible impact"],
];

const principles = [
  ["Local first", "No cloud, no account, no LLM provider required."],
  ["Explainable", "Every finding names its file, lines, and confidence."],
  ["Git-safe", "No automatic push, merge, or changes to active branches."],
  ["Cross-repo", "Website, app, billing, and docs stay in view together."],
];

const title = "Amanos — Decisions that don't fade";
const description =
  "The local decision memory for vibe coding. Amanos finds decisions in notes and tracks their possible impact across git repositories.";
---

<Base title={title} description={description} path="/">
  <section class="hero" id="top">
    <div class="shell hero-grid">
      <div>
        <h1>Decisions,<br />that don't <span class="serif">fade.</span></h1>
        <p class="hero-lead">Amanos finds decisions in your notes and traces their impact across repos. Local and transparent.</p>
        <div class="hero-actions">
          <a class="button" href="#system">How Amanos works <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-meta">
          <div class="hero-meta-row"><span>Category</span><strong>Local-first Developer Tool</strong></div>
          <div class="hero-meta-row"><span>Role</span><strong>Decision memory</strong></div>
          <div class="hero-meta-row"><span>Character</span><strong>Attentive · precise · careful</strong></div>
          <div class="hero-meta-row"><span>Form</span><strong>CLI · npm · no account</strong></div>
        </div>
      </div>
      <HeroAquarium />
    </div>
  </section>

  <section class="section shell" id="kern">
    <p class="kicker">01 / Brand core</p>
    <div class="statement">
      <p class="statement-quote">Amanos clears up context, <span class="serif">without taking control.</span></p>
      <div class="statement-body">
        <p>
          Scattered notes become a traceable record: DECISIONS.md, a readable, append-only source of truth ready for your
          next coding agent.
        </p>
        <a class="text-link" href="/docs">Read the docs <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="pillars">
      {
        pillars.map((pillar) => (
          <article class="pillar">
            <span class="pillar-symbol" aria-hidden="true">
              {pillar.symbol}
            </span>
            <span class="pillar-index">{pillar.index}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell" id="system">
    <p class="kicker">02 / Product system</p>
    <h2>Evidence before <span class="serif">claims.</span></h2>
    <div class="system-demo">
      <article class="decision-card">
        <div class="decision-top">
          <span>Decision detected</span><b>Confidence 87%</b>
        </div>
        <p class="decision-id">D-014</p>
        <h3>API rate limit: 100 req/min</h3>
        <p class="decision-source">notes/api.md · line 8–19</p>
      </article>
      <div class="status-list" aria-label="Status system">
        {
          statuses.map(([icon, name, meaning]) => (
            <div class="status-row">
              <span class="status-icon" aria-hidden="true">
                {icon}
              </span>
              <b>{name}</b>
              <small>{meaning}</small>
            </div>
          ))
        }
      </div>
    </div>

    <div class="terminal" aria-label="Example Amanos terminal output">
      <div class="terminal-head">
        <i></i><i></i><i></i><span>amanos — local</span>
      </div>
      <pre><span class="prompt">$</span> amanos scan ~/workspace

3 active decisions
<span class="candidate-line">7 candidate impacts</span>
1 blocked change
Last scan: just now

No files changed. Review DECISIONS.md →</pre>
    </div>
    <p class="source-note">
      Every finding names its file, lines, and confidence. Candidates are suggestions to review — not completed changes.
    </p>
  </section>

  <section class="section dark-section" id="prinzipien">
    <div class="shell dark-grid">
      <div>
        <p class="kicker light">03 / Principles</p>
        <h2>Your code.<br />Your rules.<br /><span class="serif">Your machine.</span></h2>
        <p class="intro" style="font-size:16px">Amanos runs where your workspace already lives: on your machine.</p>
      </div>
      <div class="principles">
        {
          principles.map(([name, text], index) => (
            <article>
              <span>0{index + 1}</span>
              <div>
                <h3>{name}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section shell closing">
    <div>
      <svg class="closing-mark" viewBox="0 0 120 105" aria-hidden="true">
        <rect x="10" y="44" width="28" height="51" rx="14" fill="#ec6b3b"></rect>
        <rect x="46" y="10" width="28" height="85" rx="14" fill="#ec6b3b"></rect>
        <rect x="82" y="28" width="28" height="67" rx="14" fill="#ec6b3b"></rect>
      </svg>
      <h2>Context fades.<br /><span class="serif">Amanos stays.</span></h2>
      <div class="hero-actions">
        <a class="button" href="#top">Read from the top <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </section>
</Base>

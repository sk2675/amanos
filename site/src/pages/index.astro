---
import Base from "../layouts/Base.astro";

const pillars = [
  {
    symbol: "⌁",
    index: "01 — MEMORY",
    title: "Kontext bleibt.",
    text: "Entscheidungen werden zur lesbaren, langlebigen Spur statt zu flüchtigem Chat-Verlauf.",
  },
  {
    symbol: "⌕",
    index: "02 — TRACE",
    title: "Folgen werden sichtbar.",
    text: "Amanos verbindet eine Entscheidung mit möglichen Auswirkungen — als Kandidaten, nicht als Behauptungen.",
  },
  {
    symbol: "✓",
    index: "03 — CONTROL",
    title: "Menschen entscheiden.",
    text: "Kein stiller Push, kein automatischer Merge, keine unsichtbare Änderung im aktiven Branch.",
  },
];

const statuses = [
  ["○", "draft", "noch unsicher"],
  ["●", "active", "gültige Entscheidung"],
  ["!", "blocked", "nächster Schritt nötig"],
  ["✓", "done", "lokal umgesetzt"],
  ["◇", "candidate", "mögliche Auswirkung"],
];

const principles = [
  ["Local first", "Keine Cloud, kein Konto und kein eigener LLM-Provider."],
  ["Erklärbar", "Jeder Fund nennt Datei, Zeilen und Confidence."],
  ["Git-sicher", "Kein automatischer Push, Merge oder Eingriff in aktive Branches."],
  ["Repo-übergreifend", "Website, App, Billing und Doku bleiben gemeinsam im Blick."],
];

const commands = [
  ["amanos init", "~/workspace", "Legt das Gedächtnis an: DECISIONS.md als append-only Datei."],
  ["amanos scan", "~/workspace", "Liest Notizen, erkennt Entscheidungen und markiert mögliche Auswirkungen."],
  ["amanos watch", "~/workspace", "Beobachtet Änderungen und meldet neue Kandidaten, ohne etwas zu schreiben."],
  ["amanos status", "~/workspace", "Zeigt aktive Entscheidungen, offene Kandidaten und blockierte Schritte."],
];

const checks = [
  ["Kontrolle bleibt sichtbar.", "Kein Push, kein Merge und keine Änderung ohne deine Freigabe."],
  ["Quelle vor Sicherheit.", "Entscheidung, Pfad, Zeilen und Confidence erscheinen gemeinsam."],
  ["Status ist mehr als Farbe.", "Jeder Zustand hat Text und Icon — nicht nur einen Farbton."],
  ["Worte bleiben ehrlich.", "„Kandidat“ statt Gewissheit, „vorbereitet“ statt automatisch erledigt."],
];

const title = "Amanos — Entscheidungen, die nicht versanden";
const description =
  "Das lokale Entscheidungs-Gedächtnis für Vibe-Coding. Amanos erkennt Entscheidungen in Notizen und verfolgt mögliche Auswirkungen über mehrere Git-Repositories.";
---

<Base title={title} description={description} path="/">
  <section class="hero" id="top">
    <div class="shell hero-grid">
      <div>
        <div class="version"><b>V1</b><span>In Arbeit · September 2026</span></div>
        <h1>Entscheidungen,<br />die nicht <span class="serif">versanden.</span></h1>
        <p class="hero-lead">
          Amanos erkennt Entscheidungen in deinen Notizen, hält Quelle und Sicherheit fest und verfolgt mögliche Auswirkungen
          durch mehrere Git-Repositories. Lokal, nachvollziehbar und mit klaren Grenzen.
        </p>
        <div class="hero-actions">
          <a class="button" href="#system">So arbeitet Amanos <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#v1">V1 Scope <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-meta">
        <div class="hero-meta-row"><span>Kategorie</span><strong>Local-first Developer Tool</strong></div>
        <div class="hero-meta-row"><span>Rolle</span><strong>Entscheidungs-Gedächtnis</strong></div>
        <div class="hero-meta-row"><span>Charakter</span><strong>Aufmerksam · präzise · behutsam</strong></div>
        <div class="hero-meta-row"><span>Form</span><strong>CLI · npm · ohne Konto</strong></div>
      </div>
    </div>
  </section>

  <section class="section shell" id="kern">
    <p class="kicker">01 / Markenkern</p>
    <div class="statement">
      <p class="statement-quote">Amanos räumt Kontext auf, <span class="serif">ohne Kontrolle zu übernehmen.</span></p>
      <div class="statement-body">
        <p>
          Aus verstreuten Notizen wird ein nachvollziehbarer Zustand: DECISIONS.md als lesbare Wahrheit, append-only und bereit
          für den nächsten Coding-Agenten.
        </p>
        <div class="tag-row" aria-label="Markenattribute">
          <span class="tag">Caretaker</span><span class="tag">Investigator</span><span class="tag">Local-first</span><span
            class="tag">Git-safe</span
          >
        </div>
      </div>
    </div>

    <div class="pillars">
      {
        pillars.map((pillar) => (
          <article class="pillar">
            <span class="pillar-symbol" aria-hidden="true">
              {pillar.symbol}
            </span>
            <span class="pillar-index">{pillar.index}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell" id="system">
    <p class="kicker">02 / Produktsystem</p>
    <h2>Beweise vor <span class="serif">Behauptungen.</span></h2>
    <div class="system-demo">
      <article class="decision-card">
        <div class="decision-top">
          <span class="pulse" aria-hidden="true"></span><span>Entscheidung erkannt</span><b>Confidence 87%</b>
        </div>
        <p class="decision-id">D-014</p>
        <h3>Pro-Plan kostet 29 €</h3>
        <p class="decision-source">notes/pricing.md · Zeile 42–58</p>
      </article>
      <div class="status-list" aria-label="Statussystem">
        {
          statuses.map(([icon, name, meaning]) => (
            <div class="status-row">
              <span class="status-icon" aria-hidden="true">
                {icon}
              </span>
              <b>{name}</b>
              <small>{meaning}</small>
            </div>
          ))
        }
      </div>
    </div>

    <div class="terminal" aria-label="Beispiel für eine Amanos Terminalausgabe">
      <div class="terminal-head">
        <i></i><i></i><i></i><span>amanos — local</span>
      </div>
      <pre><span class="prompt">$</span> amanos scan ~/workspace

3 active decisions
<span class="candidate-line">7 candidate impacts</span>
1 blocked change
Last scan: just now

No files changed. Review DECISIONS.md →</pre>
    </div>
    <p class="source-note">
      Jeder Fund nennt Datei, Zeilen und Confidence. Kandidaten sind Vorschläge zur Prüfung — keine erledigten Änderungen.
    </p>
  </section>

  <section class="section dark-section" id="prinzipien">
    <div class="shell dark-grid">
      <div>
        <p class="kicker light">03 / Prinzipien</p>
        <h2>Dein Code.<br />Deine Regeln.<br /><span class="serif">Dein Rechner.</span></h2>
        <p class="intro" style="font-size:16px">Amanos arbeitet dort, wo dein Workspace ohnehin liegt: auf deiner Maschine.</p>
      </div>
      <div class="principles">
        {
          principles.map(([name, text], index) => (
            <article>
              <span>0{index + 1}</span>
              <div>
                <h3>{name}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section shell" id="v1">
    <p class="kicker">04 / V1 Scope</p>
    <div class="scope-grid">
      <div>
        <h2>Ein CLI.<br /><span class="serif">Vier Befehle.</span></h2>
        <p class="intro" style="font-size:16px">
          Die erste Version entsteht als lokales npm-CLI. Kein Dashboard, kein Backend, kein Plattform-Lock-in.
        </p>
      </div>
      <div class="command-list">
        {
          commands.map(([command, argument, text]) => (
            <div>
              <code>
                <b>$</b> {command} {argument}
              </code>
              <p>{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section shell" id="leitplanken">
    <p class="kicker">05 / Leitplanken</p>
    <h2>Was Amanos <span class="serif">nicht</span> tut.</h2>
    <div class="checklist">
      {
        checks.map(([name, text]) => (
          <article class="check">
            <h3>{name}</h3>
            <p>{text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section shell closing">
    <div>
      <svg class="closing-mark" viewBox="0 0 120 105" aria-hidden="true">
        <rect x="10" y="44" width="28" height="51" rx="14" fill="#ec6b3b"></rect>
        <rect x="46" y="10" width="28" height="85" rx="14" fill="#ec6b3b"></rect>
        <rect x="82" y="28" width="28" height="67" rx="14" fill="#ec6b3b"></rect>
      </svg>
      <h2>Kontext geht.<br /><span class="serif">Amanos bleibt.</span></h2>
      <div class="hero-actions">
        <a class="button" href="#top">Von vorn lesen <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </section>
</Base>

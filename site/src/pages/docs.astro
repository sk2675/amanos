---
import Base from "../layouts/Base.astro";

const commands = [
  ["amanos init", "~/workspace", "Sets up the memory: DECISIONS.md as an append-only file."],
  ["amanos scan", "~/workspace", "Reads notes, detects decisions, and flags possible impacts."],
  ["amanos watch", "~/workspace", "Watches for changes and reports new candidates without writing anything."],
  ["amanos status", "~/workspace", "Shows active decisions, open candidates, and blocked steps."],
];

const title = "Docs — Amanos";
const description = "Current version status and CLI scope for Amanos.";
---

<Base title={title} description={description} path="/docs">
  <section class="section shell">
    <p class="kicker">Docs</p>
    <div class="version"><b>V1</b><span>In progress · September 2026</span></div>
    <h1>One CLI.<br /><span class="serif">Four commands.</span></h1>
    <p class="intro" style="font-size:16px">
      The first version ships as a local npm CLI. No dashboard, no backend, no platform lock-in.
    </p>

    <div class="command-list" style="margin-top:40px">
      {
        commands.map(([command, argument, text]) => (
          <div>
            <code>
              <b>$</b> {command} {argument}
            </code>
            <p>{text}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";

const commands = [
  ["amanos init", "~/workspace", "Creates DECISIONS.md plus the local config and state files without overwriting existing files."],
  ["amanos scan", "~/workspace", "Reads supported notes, records new decisions, and updates candidate impacts."],
  ["amanos watch", "~/workspace", "Watches recursively and runs a writing scan after the configured quiet period (60 seconds by default)."],
  ["amanos status", "~/workspace", "Shows active and draft decisions, candidate impacts, blocked changes, and the last scan."],
];

const title = "Docs — Amanos";
const description = "Current version status and CLI scope for Amanos.";
---

<Base title={title} description={description} path="/docs">
  <section class="section shell">
    <p class="kicker">Docs</p>
    <div class="version"><b>V1 · 0.1.0</b><span>Release candidate · 6 September 2026</span></div>
    <h1>One CLI.<br /><span class="serif">Four commands.</span></h1>
    <p class="intro" style="font-size:16px">
      The V1 source is feature-complete and in release review. Install it from the source repository until version <code>0.1.0</code> is available both on npm and as a GitHub Release. The published <code>amanos@0.0.1</code> package is a broken stub and is not V1.
    </p>

    <div class="command-list" style="margin-top:40px">
      {
        commands.map(([command, argument, text]) => (
          <div>
            <code>
              <b>$</b> {command} {argument}
            </code>
            <p>{text}</p>
          </div>
        ))
      }
    </div>

    <p class="intro" style="font-size:16px; margin-top:40px">
      V1 does not invoke a coding agent or create branches, commits, or tests. It never pushes or merges. Both <code>scan</code> and <code>watch</code> may update <code>DECISIONS.md</code> and <code>.amanos/state.json</code>; use <code>scan --dry-run</code> for a preview without writes.
    </p>
  </section>
</Base>
